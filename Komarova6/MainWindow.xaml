<Window x:Class="Komarova6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Komarova6"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Окружность"/>
            <TextBox x:Name="cx" Text="100"/>
            <TextBox x:Name="cy" Text="100"/>
            <TextBox x:Name="cr" Text="50"/>
            <Button Content="Нарисовать круг" Click="Circle_Click"/>

            <TextBlock Text="Треугольник" Margin="0,10,0,0"/>
            <TextBox x:Name="tx" Text="400"/>
            <TextBox x:Name="ty" Text="150"/>
            <TextBox x:Name="ta" Text="150"/>
            <TextBox x:Name="tb" Text="150"/>
            <TextBox x:Name="tc" Text="150"/>
            <Button Content="Нарисовать треугольник" Click="Triangle_Click"/>

            <TextBlock x:Name="info" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <Canvas x:Name="cv" Grid.Column="1" Background="White"/>
    </Grid>
</Window>
